# Runtime
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Django (replace outside local development)
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL / Redis
DATABASE_URL=postgresql://careergize:careergize@postgres:5432/careergize_pulse
REDIS_URL=redis://redis:6379/0

# Telephony adapter (use "none" until a provider is configured)
TELEPHONY_PROVIDER=none
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_WEBHOOK_SECRET=

# S3-compatible storage (local keeps files on disk)
STORAGE_PROVIDER=local
STORAGE_BUCKET=careergize-pulse
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# Frontend: only NEXT_PUBLIC_* values are exposed to browsers
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
